# Copy to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars

# Must be globally unique and not already created (Terraform creates it)
project_id      = "bch-dbt-analysis"
project_name    = "Bitcoin Cash dbt Analysis"
billing_account = "XXXXXX-XXXXXX-XXXXXX"

# Optional — only if you have an org / folder
# org_id    = "123456789012"
# folder_id = "123456789012"

region            = "europe-west1"
bigquery_location = "US" # must match bigquery-public-data (US)

staging_dataset_id = "staging"
mart_dataset_id    = "mart"

dbt_service_account_id           = "dbt-runner"
dbt_service_account_display_name = "dbt Runner"
